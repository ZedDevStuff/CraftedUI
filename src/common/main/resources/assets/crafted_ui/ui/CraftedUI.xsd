<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="CraftedElement" mixed="true">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax" />
    </xs:sequence>
    <xs:attribute name="id">
      <xs:annotation>
        <xs:documentation>Unique identifier for this element</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="style">
      <xs:annotation>
        <xs:documentation>Used by some renderers to determine how to render this element</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="tooltip">
      <xs:annotation>
        <xs:documentation>Text shown after hovering this element</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="zIndex" />
    <xs:attribute name="disabled" />
    <xs:attribute name="direction" />
    <xs:attribute name="flexDirection" />
    <xs:attribute name="justifyContent" />
    <xs:attribute name="alignContent" />
    <xs:attribute name="alignItems" />
    <xs:attribute name="alignSelf" />
    <xs:attribute name="positionType" />
    <xs:attribute name="flexWrap" />
    <xs:attribute name="overflow" />
    <xs:attribute name="display" />
    <xs:attribute name="boxSizing" />
    <xs:attribute name="flex" />
    <xs:attribute name="flexGrow" />
    <xs:attribute name="flexShrink" />
    <xs:attribute name="flexBasis" />
    <xs:attribute name="margin" />
    <xs:attribute name="marginTop" />
    <xs:attribute name="marginRight" />
    <xs:attribute name="marginBottom" />
    <xs:attribute name="marginLeft" />
    <xs:attribute name="position" />
    <xs:attribute name="top" />
    <xs:attribute name="right" />
    <xs:attribute name="bottom" />
    <xs:attribute name="left" />
    <xs:attribute name="padding" />
    <xs:attribute name="paddingTop" />
    <xs:attribute name="paddingRight" />
    <xs:attribute name="paddingBottom" />
    <xs:attribute name="paddingLeft" />
    <xs:attribute name="border" />
    <xs:attribute name="borderTop" />
    <xs:attribute name="borderRight" />
    <xs:attribute name="borderBottom" />
    <xs:attribute name="borderLeft" />
    <xs:attribute name="gap" />
    <xs:attribute name="rowGap" />
    <xs:attribute name="columnGap" />
    <xs:attribute name="size" />
    <xs:attribute name="width" />
    <xs:attribute name="height" />
    <xs:attribute name="minSize" />
    <xs:attribute name="minWidth" />
    <xs:attribute name="minHeight" />
    <xs:attribute name="maxSize" />
    <xs:attribute name="maxWidth" />
    <xs:attribute name="maxHeight" />
    <xs:attribute name="onFocusGained" />
    <xs:attribute name="onFocusLost" />
    <xs:attribute name="onMouseMove" />
    <xs:attribute name="onMouseScroll" />
    <xs:attribute name="onMouseEnter" />
    <xs:attribute name="onMouseExit" />
    <xs:attribute name="onMousePress" />
    <xs:attribute name="onMouseRelease" />
    <xs:attribute name="onClick" />
    <xs:attribute name="onKeyPress" />
    <xs:attribute name="onKeyRelease" />
    <xs:attribute name="onKeyType" />
    <xs:attribute name="renderer">
      <xs:annotation>
        <xs:documentation>The renderer to use for this element.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="CraftedRoot">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="title">
          <xs:annotation>
            <xs:documentation>Title of the document, used for screen title and other purposes</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="treeRenderer">
          <xs:annotation>
            <xs:documentation>The renderer to use for elements in the tree</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Box">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="color">
          <xs:annotation>
            <xs:documentation>Background color of the box</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="ScrollView">
    <xs:complexContent>
      <xs:extension base="Box">
        <xs:attribute name="scrollX" />
        <xs:attribute name="scrollY" />
        <xs:attribute name="horizontalScrollbar" />
        <xs:attribute name="verticalScrollbar" />
        <xs:attribute name="autoHideScrollbars" />
        <xs:attribute name="scrollbarSize" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="List">
    <xs:complexContent>
      <xs:extension base="ScrollView">
        <xs:attribute name="items" />
        <xs:attribute name="extractor" />
        <xs:attribute name="bindingPrefix" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Button">
    <xs:complexContent>
      <xs:extension base="CraftedElement" />
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Input">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="onSubmit" />
        <xs:attribute name="value" />
        <xs:attribute name="allowTabNavigation" />
        <xs:attribute name="tabSize" />
        <xs:attribute name="allowArrowNavigation" />
        <xs:attribute name="placeholder" />
        <xs:attribute name="textColor" />
        <xs:attribute name="placeholderColor" />
        <xs:attribute name="selectionColor" />
        <xs:attribute name="settings" />
        <xs:attribute name="font" />
        <xs:attribute name="fontScale" />
        <xs:attribute name="wrapWidth" />
        <xs:attribute name="shadow" />
        <xs:attribute name="shadowColor" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="TextArea">
    <xs:complexContent>
      <xs:extension base="Input">
        <xs:attribute name="textWrap" />
        <xs:attribute name="scrollX" />
        <xs:attribute name="scrollY" />
        <xs:attribute name="horizontalScrollbar" />
        <xs:attribute name="verticalScrollbar" />
        <xs:attribute name="autoHideScrollbars" />
        <xs:attribute name="scrollbarSize" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Dropdown">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="options" />
        <xs:attribute name="labelProvider" />
        <xs:attribute name="selectedValue" />
        <xs:attribute name="valueType" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Conditional">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="expanded" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Image">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="src" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Tab">
    <xs:complexContent>
      <xs:extension base="ScrollView">
        <xs:attribute name="title" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Checkbox">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="checked">
          <xs:annotation>
            <xs:documentation>Whether the checkbox is checked or not. Can be null for an indeterminate state</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute name="indeterminate">
          <xs:annotation>
            <xs:documentation>Whether the checkbox supports an indeterminate state. Checked will allow null if this is true</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Either">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="value" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Text">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="text" />
        <xs:attribute name="settings" />
        <xs:attribute name="font" />
        <xs:attribute name="fontScale" />
        <xs:attribute name="wrapWidth" />
        <xs:attribute name="textWrap" />
        <xs:attribute name="shadow" />
        <xs:attribute name="shadowColor" />
        <xs:attribute name="color" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Tabs">
    <xs:complexContent>
      <xs:extension base="CraftedElement">
        <xs:attribute name="currentTabIndex" />
        <xs:attribute name="tabBarPosition" />
        <xs:attribute name="tabBarHeight" />
        <xs:attribute name="minTabWidth" />
        <xs:attribute name="maxTabWidth" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="List" type="List">
    <xs:annotation>
      <xs:documentation>Displays a list of items using a template for each item.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Button" type="Button">
    <xs:annotation>
      <xs:documentation>A simple button element</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="TextArea" type="TextArea">
    <xs:annotation>
      <xs:documentation>A multiline text input field that allows users to enter and edit text.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Dropdown" type="Dropdown" />
  <xs:element name="Input" type="Input">
    <xs:annotation>
      <xs:documentation>A text input field that allows users to enter and edit text.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Conditional" type="Conditional">
    <xs:annotation>
      <xs:documentation>Displays its single child element only while the &apos;expanded&apos; property is true.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Image" type="Image">
    <xs:annotation>
      <xs:documentation>Displays a texture or sprite on the screen</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Tab" type="Tab">
    <xs:annotation>
      <xs:documentation>A tab in a Tabs element</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Checkbox" type="Checkbox">
    <xs:annotation>
      <xs:documentation>Checkbox element, can be checked or unchecked</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Either" type="Either">
    <xs:annotation>
      <xs:documentation>Displays one of the two child elements based on the &apos;value&apos; property.</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Text" type="Text">
    <xs:annotation>
      <xs:documentation>Displays text on the screen</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Crafted" type="CraftedRoot">
    <xs:annotation>
      <xs:documentation>Root element of a Crafted document. All other elements must be children of this element</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Box" type="Box">
    <xs:annotation>
      <xs:documentation>A basic box element, used for backgrounds and other simple UI elements</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="Tabs" type="Tabs">
    <xs:annotation>
      <xs:documentation>A tabbed container element</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:element name="ScrollView" type="ScrollView" />
</xs:schema>