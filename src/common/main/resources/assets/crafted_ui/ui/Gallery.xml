<Crafted title="Gallery" renderer="default" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="CraftedUI.xsd">
    <Box id="header" color="primary" height="32" flexDirection="row" alignItems="center">
        <Box>
            <Button renderer="crafted" style="error" size="16" onClick="exit">x</Button>
            <Button tooltip="Copy XML Schema" renderer="crafted" style="info" size="16" onClick="copySchema">
                <Image size="16" />
            </Button>
        </Box>
        <Text color="onBackground" marginLeft="8" fontScale="1.5">Crafted UI Gallery</Text>
    </Box>
    <Box color="background" flex="1">
        <Tabs flex="1">
            <Tab title="Buttons" gap="4" flexDirection="row" flexWrap="wrap" padding="2">
                <Button onClick="sayHi" width="60" disabled="true">Disabled</Button>
                <Button onClick="sayHi" width="60">Minecraft</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" disabled="true">Disabled</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="primary">Primary</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="secondary">Secondary</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="error">Error</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="warning">Warning</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="success">Success</Button>
                <Button onClick="sayHi" renderer="crafted" width="60" style="info">Info</Button>
            </Tab>
            <Tab title="Inputs" gap="4" flexDirection="row" flexWrap="wrap" padding="2">
                <Input onSubmit="printSubmit" width="200" height="20" placeholder="Search..." />
                <TextArea onSubmit="printSubmit" allowTabNavigation="false" size="200,60" />
                <Checkbox size="20,20" />
                <Checkbox renderer="crafted" size="20,20" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="primary" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="secondary" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="error" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="warning" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="success" />
                <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="info" />
                <Dropdown options="testOptions" size="100,20" />
                <Dropdown renderer="crafted" options="testOptions" size="100,20" />
            </Tab>
            <Tab title="Dynamic" gap="4" padding="2">
                <Box>
                    <Checkbox id="eitherToggle" size="20"/>
                    <Either id="either" value="$bind:eitherToggle.checked">
                        <Text color="success">Either: primary</Text>
                        <Text color="error">Either: fallback</Text>
                    </Either>
                </Box>
                <Box>
                    <List items="testOptions" extractor="optionExtractor">
                        <Text text="value"></Text>
                    </List>
                </Box>
            </Tab>
            <Tab title="Display" gap="4" flexDirection="row" flexWrap="wrap" padding="2">
                <Image size="32" src="minecraft:textures/block/grass_block_side.png" />
                <Image size="32" src="minecraft:textures/block/diamond_block.png" />
                <Image size="32" src="minecraft:textures/block/gold_block.png" />
            </Tab>
            <Tab title="Colors" flex="1">
                <ScrollView flex="1" flexDirection="row" flexWrap="wrap">
                    <Box color="primary" size="50%,20" padding="2,0,0,2"><Text color="onPrimary">Primary</Text></Box>
                    <Box color="primaryContainer" size="50%,20" padding="2,0,0,2"><Text color="onPrimaryContainer">Primary Container</Text></Box>
                    <Box color="secondary" size="50%,20" padding="2,0,0,2"><Text color="onSecondary">Secondary</Text></Box>
                    <Box color="background" size="50%,20" padding="2,0,0,2"><Text color="onBackground">Background</Text></Box>
                    <Box color="surface" size="50%,20" padding="2,0,0,2"><Text color="onSurface">Surface</Text></Box>
                    <Box color="surfaceVariant" size="50%,20" padding="2,0,0,2"><Text color="onSurface">Surface Variant</Text></Box>
                    <Box color="outline" size="50%,20" padding="2,0,0,2"><Text>Outline</Text></Box>
                    <Box color="disabled" size="50%,20" padding="2,0,0,2"><Text>Disabled</Text></Box>
                    <Box color="scrim" size="50%,20" padding="2,0,0,2"><Text>Scrim</Text></Box>
                    <Box color="error" size="50%,20" padding="2,0,0,2"><Text color="onError">Error</Text></Box>
                    <Box color="warning" size="50%,20" padding="2,0,0,2"><Text color="onWarning">Warning</Text></Box>
                    <Box color="success" size="50%,20" padding="2,0,0,2"><Text color="onSuccess">Success</Text></Box>
                    <Box color="info" size="50%,20" padding="2,0,0,2"><Text color="onInfo">Info</Text></Box>
                </ScrollView>
            </Tab>
        </Tabs>
    </Box>
</Crafted>