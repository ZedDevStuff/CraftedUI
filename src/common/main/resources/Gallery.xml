<Crafted renderer="default" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="CraftedUI.xsd">
    <Box id="window" color="background" flex="1" flexDirection="column">
        <Box id="header" color="primary" height="32" flexDirection="row" alignItems="center">
            <Text color="onBackground" fontScale="1.5">Crafted UI Gallery</Text>
        </Box>
        <Text color="onBackground" margin="2">Buttons</Text>
        <Box id="buttons" gap="4" flexDirection="row" flexWrap="wrap" margin="2">
            <Button onClick="sayHi" width="60" disabled="true">Disabled</Button>
            <Button onClick="sayHi" width="60">Minecraft</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" disabled="true">Crafted</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" style="primary">Crafted</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" style="secondary">Crafted</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" style="error">Crafted</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" style="warning">Crafted</Button>
            <Button onClick="sayHi" renderer="crafted" width="60" style="success">Crafted</Button>
        </Box>
        <Text color="onBackground" margin="2">Inputs</Text>
        <Box id="inputs" gap="4" flexDirection="row" flexWrap="wrap" margin="2">
            <Input onSubmit="printSubmit" width="200" height="20" placeholder="Search..." />
            <Checkbox size="20,20" />
            <Checkbox renderer="crafted" size="20,20" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" checked="" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="primary" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="secondary" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="error" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="warning" />
            <Checkbox renderer="crafted" size="20,20" indeterminate="true" style="success" />
        </Box>
        <ScrollView height="200" alignSelf="stretch" horizontalScrollbar="false">
            <Text color="onBackground" margin="2">Misc</Text>
            <Box id="misc" gap="4" flexDirection="row" flexWrap="wrap" margin="2">
                <Image src="minecraft:textures/block/stone.png" width="64" height="64" />
            </Box>
            <Box>
                <Box width="25">
                    <Button onClick="sayHi" renderer="crafted">Overflow</Button>
                </Box>
                <Box width="25" overflow="hidden">
                    <Button onClick="sayHi" renderer="crafted">Hidden</Button>
                </Box>
            </Box>
        </ScrollView>
    </Box>
</Crafted>